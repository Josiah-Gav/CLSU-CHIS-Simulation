{
  "info": {
    "name": "CHIS Simulation API v1",
    "description": "Exercises every endpoint in docs/API_CONTRACT.md. Select the 'CHIS Simulation - Local' environment, then run the whole collection in order with the Collection Runner: every request carries tests that assert the contract.\n\nThe collection pre-request script picks a fresh random telemed_encounter_id once per run, so re-running never collides with an earlier run's data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{chis_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One fresh encounter id per collection run; the 'Send' request clears it at the start.",
          "if (!pm.collectionVariables.get('telemed_encounter_id')) {",
          "    pm.collectionVariables.set('telemed_encounter_id', 100000 + Math.floor(Math.random() * 900000));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "telemed_encounter_id",
      "value": ""
    },
    {
      "key": "chis_encounter_id",
      "value": ""
    },
    {
      "key": "unknown_patient_encounter_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health check (no auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Service is ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Liveness check. No token required.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Patients (CHIS -> Telemed)",
      "item": [
        {
          "name": "Get patient - full profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().data;",
                  "pm.test(\"Returns the requested patient\", () => pm.expect(p.clsu_id).to.eql(\"23-0001\"));",
                  "pm.test(\"Has a medical profile with list fields\", () => {",
                  "    [\"allergies\",\"chronic_conditions\",\"current_medications\",\"immunizations\",\"family_history\"].forEach(k => pm.expect(p.medical_profile[k]).to.be.an(\"array\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/patients/23-0001",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "23-0001"
              ]
            },
            "description": "Seeded patient with a populated medical profile."
          }
        },
        {
          "name": "Get patient - empty profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Allergies is an empty array, not null\", () => pm.expect(pm.response.json().data.medical_profile.allergies).to.eql([]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/patients/23-0002",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "23-0002"
              ]
            },
            "description": "Seeded patient whose medical profile lists are all empty arrays."
          }
        },
        {
          "name": "Get patient - identity mismatch fixture",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Is the mismatch fixture\", () => pm.expect(pm.response.json().data.last_name).to.eql(\"Santos\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/patients/26-000001",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "26-000001"
              ]
            },
            "description": "Returns Maria Santos. Telemed must refuse to display this record for an account with a different name (see contract section 5)."
          }
        },
        {
          "name": "Get patient - long-tenured staff ID format",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the YYYY-NNNN id unchanged\", () => pm.expect(pm.response.json().data.clsu_id).to.eql(\"1996-0042\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/patients/1996-0042",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "1996-0042"
              ]
            },
            "description": "Seeded staff member with the older YYYY-NNNN ID scheme."
          }
        },
        {
          "name": "Get patient - leading zeros are significant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is PATIENT_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.eql(\"PATIENT_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/patients/23-1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "23-1"
              ]
            },
            "description": "23-1 is not 23-0001: IDs are compared as strings, never as numbers."
          }
        },
        {
          "name": "Get patient - not found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is PATIENT_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.eql(\"PATIENT_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/patients/99-9999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "99-9999"
              ]
            },
            "description": "Unknown clsu_id."
          }
        },
        {
          "name": "Get patient - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error code is UNAUTHENTICATED\", () => pm.expect(pm.response.json().code).to.eql(\"UNAUTHENTICATED\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/patients/23-0001",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "patients",
                "23-0001"
              ]
            },
            "description": "Same request without a bearer token.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "3. Encounters (Telemed -> CHIS)",
      "item": [
        {
          "name": "Send encounter - first time",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('telemed_encounter_id', 100000 + Math.floor(Math.random() * 900000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Has a CHIS encounter id\", () => pm.expect(d.chis_encounter_id).to.match(/^ENC-\\d{4}-\\d{6}$/));",
                  "pm.test(\"Echoes the Telemed id\", () => pm.expect(d.telemed_encounter_id).to.eql(Number(pm.collectionVariables.get(\"telemed_encounter_id\"))));",
                  "pm.collectionVariables.set(\"chis_encounter_id\", d.chis_encounter_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/encounters",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "encounters"
              ]
            },
            "description": "A completed consultation summary, as Telemed sends it. Expect 201 and a CHIS reference.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema_version\": \"1.0\",\n  \"telemed_encounter_id\": {{telemed_encounter_id}},\n  \"telemed_request_id\": 456,\n  \"consent\": {\n    \"data_sharing_consented_at\": \"2026-10-01T09:12:00+08:00\"\n  },\n  \"patient\": {\n    \"clsu_id\": \"23-0001\",\n    \"first_name\": \"QA\",\n    \"last_name\": \"Patient\"\n  },\n  \"physician\": {\n    \"telemed_user_id\": 7,\n    \"name\": \"Dr. QA Physician\",\n    \"specialization\": \"Internal Medicine\"\n  },\n  \"encounter\": {\n    \"type\": \"general\",\n    \"parent_telemed_encounter_id\": null,\n    \"mode\": \"teleconsultation\",\n    \"started_at\": \"2026-10-22T13:30:00+08:00\",\n    \"completed_at\": \"2026-10-22T14:05:00+08:00\"\n  },\n  \"presenting_complaint\": {\n    \"concern_category\": \"Respiratory\",\n    \"symptoms\": [\n      {\n        \"name\": \"Cough\",\n        \"severity\": 2,\n        \"severity_label\": \"mild\",\n        \"onset_date\": \"2026-10-19\",\n        \"onset_time\": null\n      }\n    ],\n    \"additional_information\": \"Worse at night.\"\n  },\n  \"clinical\": {\n    \"diagnosis\": \"Acute upper respiratory tract infection\",\n    \"assessment\": \"Afebrile, no respiratory distress reported.\",\n    \"plan\": \"Supportive care, increase fluid intake.\",\n    \"recommendations\": \"Return if fever exceeds 38.5 C or breathing worsens.\"\n  },\n  \"follow_up\": {\n    \"required\": false,\n    \"date\": null\n  },\n  \"prescription\": {\n    \"attached\": true,\n    \"file_name\": \"prescription-123.pdf\",\n    \"mime_type\": \"application/pdf\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send encounter - identical retry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Same CHIS reference as the first send\", () => pm.expect(pm.response.json().data.chis_encounter_id).to.eql(pm.collectionVariables.get(\"chis_encounter_id\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/encounters",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "encounters"
              ]
            },
            "description": "Exactly the same body again, as a retry would send it. Expect 200 and the same CHIS reference: no duplicate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema_version\": \"1.0\",\n  \"telemed_encounter_id\": {{telemed_encounter_id}},\n  \"telemed_request_id\": 456,\n  \"consent\": {\n    \"data_sharing_consented_at\": \"2026-10-01T09:12:00+08:00\"\n  },\n  \"patient\": {\n    \"clsu_id\": \"23-0001\",\n    \"first_name\": \"QA\",\n    \"last_name\": \"Patient\"\n  },\n  \"physician\": {\n    \"telemed_user_id\": 7,\n    \"name\": \"Dr. QA Physician\",\n    \"specialization\": \"Internal Medicine\"\n  },\n  \"encounter\": {\n    \"type\": \"general\",\n    \"parent_telemed_encounter_id\": null,\n    \"mode\": \"teleconsultation\",\n    \"started_at\": \"2026-10-22T13:30:00+08:00\",\n    \"completed_at\": \"2026-10-22T14:05:00+08:00\"\n  },\n  \"presenting_complaint\": {\n    \"concern_category\": \"Respiratory\",\n    \"symptoms\": [\n      {\n        \"name\": \"Cough\",\n        \"severity\": 2,\n        \"severity_label\": \"mild\",\n        \"onset_date\": \"2026-10-19\",\n        \"onset_time\": null\n      }\n    ],\n    \"additional_information\": \"Worse at night.\"\n  },\n  \"clinical\": {\n    \"diagnosis\": \"Acute upper respiratory tract infection\",\n    \"assessment\": \"Afebrile, no respiratory distress reported.\",\n    \"plan\": \"Supportive care, increase fluid intake.\",\n    \"recommendations\": \"Return if fever exceeds 38.5 C or breathing worsens.\"\n  },\n  \"follow_up\": {\n    \"required\": false,\n    \"date\": null\n  },\n  \"prescription\": {\n    \"attached\": true,\n    \"file_name\": \"prescription-123.pdf\",\n    \"mime_type\": \"application/pdf\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send encounter - conflicting content",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Error code is ENCOUNTER_CONFLICT\", () => pm.expect(pm.response.json().code).to.eql(\"ENCOUNTER_CONFLICT\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/encounters",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "encounters"
              ]
            },
            "description": "Same telemed_encounter_id, different diagnosis. Summaries are immutable, so CHIS rejects it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema_version\": \"1.0\",\n  \"telemed_encounter_id\": {{telemed_encounter_id}},\n  \"telemed_request_id\": 456,\n  \"consent\": {\n    \"data_sharing_consented_at\": \"2026-10-01T09:12:00+08:00\"\n  },\n  \"patient\": {\n    \"clsu_id\": \"23-0001\",\n    \"first_name\": \"QA\",\n    \"last_name\": \"Patient\"\n  },\n  \"physician\": {\n    \"telemed_user_id\": 7,\n    \"name\": \"Dr. QA Physician\",\n    \"specialization\": \"Internal Medicine\"\n  },\n  \"encounter\": {\n    \"type\": \"general\",\n    \"parent_telemed_encounter_id\": null,\n    \"mode\": \"teleconsultation\",\n    \"started_at\": \"2026-10-22T13:30:00+08:00\",\n    \"completed_at\": \"2026-10-22T14:05:00+08:00\"\n  },\n  \"presenting_complaint\": {\n    \"concern_category\": \"Respiratory\",\n    \"symptoms\": [\n      {\n        \"name\": \"Cough\",\n        \"severity\": 2,\n        \"severity_label\": \"mild\",\n        \"onset_date\": \"2026-10-19\",\n        \"onset_time\": null\n      }\n    ],\n    \"additional_information\": \"Worse at night.\"\n  },\n  \"clinical\": {\n    \"diagnosis\": \"Allergic rhinitis\",\n    \"assessment\": \"Afebrile, no respiratory distress reported.\",\n    \"plan\": \"Supportive care, increase fluid intake.\",\n    \"recommendations\": \"Return if fever exceeds 38.5 C or breathing worsens.\"\n  },\n  \"follow_up\": {\n    \"required\": false,\n    \"date\": null\n  },\n  \"prescription\": {\n    \"attached\": true,\n    \"file_name\": \"prescription-123.pdf\",\n    \"mime_type\": \"application/pdf\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send encounter - validation errors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Error code is VALIDATION_FAILED\", () => pm.expect(pm.response.json().code).to.eql(\"VALIDATION_FAILED\"));",
                  "pm.test(\"Reports each bad field\", () => {",
                  "    const e = pm.response.json().errors;",
                  "    [\"clinical.diagnosis\",\"presenting_complaint.symptoms\",\"encounter.type\"].forEach(k => pm.expect(e).to.have.property(k));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/encounters",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "encounters"
              ]
            },
            "description": "Missing diagnosis, no symptoms, invalid encounter type.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema_version\": \"1.0\",\n  \"telemed_encounter_id\": {{telemed_encounter_id}},\n  \"telemed_request_id\": 456,\n  \"consent\": {\n    \"data_sharing_consented_at\": \"2026-10-01T09:12:00+08:00\"\n  },\n  \"patient\": {\n    \"clsu_id\": \"23-0001\",\n    \"first_name\": \"QA\",\n    \"last_name\": \"Patient\"\n  },\n  \"physician\": {\n    \"telemed_user_id\": 7,\n    \"name\": \"Dr. QA Physician\",\n    \"specialization\": \"Internal Medicine\"\n  },\n  \"encounter\": {\n    \"type\": \"walk_in\",\n    \"parent_telemed_encounter_id\": null,\n    \"mode\": \"teleconsultation\",\n    \"started_at\": \"2026-10-22T13:30:00+08:00\",\n    \"completed_at\": \"2026-10-22T14:05:00+08:00\"\n  },\n  \"presenting_complaint\": {\n    \"concern_category\": \"Respiratory\",\n    \"symptoms\": [],\n    \"additional_information\": \"Worse at night.\"\n  },\n  \"clinical\": {\n    \"assessment\": \"Afebrile, no respiratory distress reported.\",\n    \"plan\": \"Supportive care, increase fluid intake.\",\n    \"recommendations\": \"Return if fever exceeds 38.5 C or breathing worsens.\"\n  },\n  \"follow_up\": {\n    \"required\": false,\n    \"date\": null\n  },\n  \"prescription\": {\n    \"attached\": true,\n    \"file_name\": \"prescription-123.pdf\",\n    \"mime_type\": \"application/pdf\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send encounter - unknown patient",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('unknown_patient_encounter_id', Number(pm.collectionVariables.get('telemed_encounter_id')) + 1);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is PATIENT_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.eql(\"PATIENT_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/encounters",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "encounters"
              ]
            },
            "description": "Valid body for a clsu_id CHIS does not know.",
